# planport config template: copy to .env (git-ignored, mode 600) and fill in.
# Env vars already set win over this file. Every key except PLANPORT_API_KEY is
# required. Syntax: KEY=VALUE, no quotes, no trailing comments.
# 🔒 keys (secrets, provider data) stay blank here and are filled only in .env;
# TestEnvExampleProjectValuesOnly enforces it.
# Provider <N> of type <T> reads key <K> from, in order:
#   PLANPORT_PROVIDER_<N>_<K> → PLANPORT_TYPE_<T>_<K> → PLANPORT_<K>

# --- planport ---
# 127.0.0.1 = this machine only. A machine IP or 0.0.0.0 opens it to the
# network and then requires PLANPORT_API_KEY (tokens are personal account keys).
PLANPORT_HOST=127.0.0.1
PLANPORT_PORT=18080
# 🔒 Network calls must send "Authorization: Bearer <key>". Calls from this
# machine never need it, so it does NOT stop other local users. Blank = local
# calls only (browsers are always blocked).
PLANPORT_API_KEY=
# Cap per upstream call (stream reading included); token refresh settings.
PLANPORT_TIMEOUT=5m
PLANPORT_REFRESH_MARGIN=5m
PLANPORT_REFRESH_TIMEOUT=30s

# --- Providers (one provider = one account) ---
# Clients pick one with "provider": "<name>"; planport never switches accounts or
# models. Names: A-Z a-z 0-9 _. TYPE: codex | openai_compat | claude_cli.
PLANPORT_PROVIDERS=codex,compat,claude

# --- provider "codex" (ChatGPT Plus/Pro plan, Codex CLI login) ---
PLANPORT_PROVIDER_CODEX_TYPE=codex
# 🔒 Codex CLI auth file
PLANPORT_PROVIDER_CODEX_CRED_FILE=

# --- provider "compat" (API key, any OpenAI-compatible chat completions API) ---
PLANPORT_PROVIDER_COMPAT_TYPE=openai_compat
# 🔒 API key file (one line, mode 600; re-read on every request)
PLANPORT_PROVIDER_COMPAT_CRED_FILE=

# --- shared values for type codex ---
# 🔒 backend root, OAuth token endpoint, client ID, OpenAI-Beta header, User-Agent
PLANPORT_TYPE_CODEX_BASE_URL=
PLANPORT_TYPE_CODEX_TOKEN_URL=
PLANPORT_TYPE_CODEX_CLIENT_ID=
PLANPORT_TYPE_CODEX_ORIGINATOR=planport
PLANPORT_TYPE_CODEX_BETA=
PLANPORT_TYPE_CODEX_USER_AGENT=

# --- shared values for type openai_compat ---
# 🔒 vendor API root (/chat/completions is appended)
PLANPORT_TYPE_OPENAI_COMPAT_BASE_URL=

# --- Example: more accounts / vendors, env only ---
# A credential file belongs to one provider (duplicates stop startup). Keep
# extra codex accounts out of the Codex CLI: refresh tokens rotate, so two
# refreshers of one token log the account out.
# PLANPORT_PROVIDERS=codex,codex2,compat,compat2
# PLANPORT_PROVIDER_CODEX2_TYPE=codex
# PLANPORT_PROVIDER_CODEX2_CRED_FILE=<auth file of account 2>
# PLANPORT_PROVIDER_COMPAT2_TYPE=openai_compat
# PLANPORT_PROVIDER_COMPAT2_CRED_FILE=<API key file of vendor 2>
# PLANPORT_PROVIDER_COMPAT2_BASE_URL=<API root of vendor 2>

# --- provider "claude" (logged-in Claude Code CLI) ---
PLANPORT_PROVIDER_CLAUDE_TYPE=claude_cli
# Claude Code binary path: the output of `command -v claude`.
PLANPORT_PROVIDER_CLAUDE_BINARY=
